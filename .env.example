# --- Chain ---
# 14 = Flare Mainnet, 114 = Coston2 testnet
CHAIN_ID=14
FLARE_RPC_URL=https://flare-api.flare.network/ext/C/rpc
# Optional override; if unset, resolved from FlareContractRegistry
ASSET_MANAGER_ADDRESS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Set after deploy: curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://<app>.vercel.app/api/telegram&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Poller ---
# GitHub Actions (or any cron) must send: Authorization: Bearer <POLL_SECRET>
POLL_SECRET=
# Alert when CR is within this many BIPS of the minimum (early warning band)
CR_WARNING_MARGIN_BIPS=2000
# Treat the poller as offline after this long without a completed poll (ms).
# Default 20 min = four missed 5-minute runs. Surfaced by GET /api/health.
STALE_AFTER_MS=1200000
